    {
      "parameters": {
        "jsCode": "// Transform Airtable Interventions → JSON propre pour le front W-E3\n// Noms vérifiés depuis output réel du node Airtable Search (15/05/2026)\n// + Lookups Machine_nom et Agent_nom ajoutés Phase 2 (16/05/2026)\n\nconst records = $input.all();\n\nconst getSelectName = (val) => {\n  if (!val) return null;\n  if (typeof val === 'string') return val;\n  if (val.name) return val.name;\n  return null;\n};\n\nconst getLinkedRecordId = (val) => {\n  if (!Array.isArray(val) || val.length === 0) return null;\n  const first = val[0];\n  if (typeof first === 'string') return first;\n  if (first && first.id) return first.id;\n  return null;\n};\n\nconst getLookupString = (val) => {\n  if (!val) return null;\n  if (typeof val === 'string') return val;\n  if (Array.isArray(val) && val.length > 0) {\n    const first = val[0];\n    if (typeof first === 'string') return first;\n    if (first && first.name) return first.name;\n  }\n  return null;\n};\n\nconst interventions = records.map(item => {\n  const f = item.json;\n  const dureeMin = typeof f.Duree_min === 'number' ? f.Duree_min : null;\n\n  return {\n    rec_id: f.id,\n    id_intervention: f.ID_Intervention ?? null,\n    date: f.Date || null,\n    type: getSelectName(f.Type),\n    type_panne: getSelectName(f.Type_panne),\n    statut: getSelectName(f.Statut),\n    duree_minutes: dureeMin,\n    duree_h: dureeMin !== null ? Math.round((dureeMin / 60) * 10) / 10 : null,\n    cout_estime: typeof f.Cout_estime === 'number' ? f.Cout_estime : null,\n    description: f.Description || '',\n    pieces_utilisees: f['Pièces_utilisées'] || '',\n    remarques_rapport: f.Remarques_rapport || '',\n    machine_rec_id: getLinkedRecordId(f.Machine),\n    machine_nom: getLookupString(f.Machine_nom),\n    agent_rec_id: getLinkedRecordId(f.Agent_intervenant),\n    agent_nom: getLookupString(f.Agent_nom)\n  };\n});\n\nreturn [{\n  json: {\n    success: true,\n    count: interventions.length,\n    timestamp: new Date().toISOString(),\n    interventions: interventions\n  }\n}];"
      },
