    {
      "parameters": {
        "jsCode": "// Transform Airtable records into a flat JSON for the frontend\nconst records = $input.all();\n\nconst agents = records.map(item => {\n  const f = item.json;  // CORRIGÉ : pas de .fields, fields sont à la racine\n  return {\n    rec_id: f.id,\n    id_agent: f.ID_Agent || null,\n    nom: f.Nom || '',\n    prenom: f.Prenom || '',\n    equipe: f.Equipe || '',\n    role: f.Role || '',\n    statut: f.Statut || '',\n    habilitations: f.Habilitations || [],\n    date_embauche: f.Date_embauche || null,\n    email: f.Email || '',\n    telephone: f['Téléphone'] || '',\n    prochaine_habilitation: f.Date_prochaine_Habilitation_a_renouveler || null,\n    notes: f.Notes_agent || ''\n  };\n});\n\nreturn [{\n  json: {\n    success: true,\n    count: agents.length,\n    timestamp: new Date().toISOString(),\n    agents: agents\n  }\n}];"
      },
