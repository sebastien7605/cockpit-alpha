      "parameters": {
        "jsCode": "// Transform Airtable Machines records into a flat JSON for the frontend\nconst records = $input.all();\n\nconst machines = records.map(item => {\n  const f = item.json;\n  return {\n    rec_id: f.id,\n    id_machine: f.ID_Machine ?? null,\n    nom: f.Nom_machine || '',\n    type: f.Type || '',\n    localisation: f.Localisation || '',\n    etat: f.Etat || '',\n    constructeur: f.Constructeur || '',\n    num_serie: f.Num_serie || '',\n    date_mise_service: f.Date_mise_service || null,\n    derniere_maintenance: f.Derniere_maintenance || null,\n    prochaine_maintenance: f.Prochaine_maintenance_Preventive || null,\n    garantie_expiration: f.Garantie_expiration || null,\n    nb_interventions: Array.isArray(f.Interventions) ? f.Interventions.length : 0,\n    nb_agents_assignes: Array.isArray(f.Agents_assignes) ? f.Agents_assignes.length : 0\n  };\n});\n\nreturn [{\n  json: {\n    success: true,\n    count: machines.length,\n    timestamp: new Date().toISOString(),\n    machines: machines\n  }\n}];"
      },
